{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install -r requirements.txt",
      "devCommand": "uvicorn main:app --reload --port 8000"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev",
      "outputDirectory": "dist",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}